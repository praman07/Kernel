# ==========================================
# BACKEND (Deploy on Render.com)
# ==========================================
# PORT=5000 (Render automatically assigns PORT dynamically)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/kernel
JWT_SECRET=your_super_secret_jwt_key_here

# ==========================================
# FRONTEND (Deploy on Vercel)
# ==========================================
# In Vercel Environment Variables setting, set:
VITE_API_URL=https://your-backend-name.onrender.com/api
